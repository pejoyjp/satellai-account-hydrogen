# Liquid 商城公开 HTTPS origin，可留空使用 https://satellai.com。
STOREFRONT_ORIGIN=

# Cognito 会话密钥，至少 32 个随机字符。为账户站生成独立密钥。
SESSION_SECRET=
COGNITO_AUTH_API_URL=
COGNITO_LEGACY_STORE_DOMAIN=

# 账户 CMS 与设备服务。CMS Origin 使用后端已登记的 Origin。
ACCOUNT_CMS_API_URL=
ACCOUNT_CMS_ORIGIN=
ACCOUNT_CMS_API_KEY=
ACCOUNT_DEVICE_API_URL=
ACCOUNT_SITE_KEY=
ACCOUNT_COUNTRY=

# Shopify 客户资料、订单和地址。配置同一店铺的域名和私有 Storefront token。
PUBLIC_STORE_DOMAIN=
PRIVATE_STOREFRONT_API_TOKEN=
PUBLIC_CHECKOUT_DOMAIN=
