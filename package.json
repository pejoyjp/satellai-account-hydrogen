{
  "name": "satellai-account-headless",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "deploy": "shopify hydrogen deploy --assets-dir dist/client --worker-dir dist/server",
    "dev": "vite dev",
    "preview": "react-router build && vite preview",
    "typecheck": "react-router typegen && tsc && hydrogen gql check --fail-on-warn",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:auth": "node --test tests/cognito-*.test.mjs",
    "test:account": "node --test tests/account-dashboard.test.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@shopify/hydrogen": "2026.10.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.1.36",
    "lucide-react": "^1.72.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "7.15.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@react-router/dev": "7.15.1",
    "@shopify/cli": "4.8.1",
    "@shopify/mini-oxygen": "4.3.0",
    "@shopify/oxygen-workers-types": "^4.1.6",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "gql.tada": "^1.9.2",
    "graphql": "^16.13.2",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  },
  "engines": {
    "node": "^22.12 || ^24"
  },
  "private": true
}
